# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/plant-tracker?retryWrites=true&w=majority

# JWT Secret — use a strong random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Cloudinary Credentials
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
